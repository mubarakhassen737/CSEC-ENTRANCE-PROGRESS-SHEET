class Solution:
    def intersection(self, nums1: List[int], nums2: List[int]) -> List[int]:
        q=list(set())
        nums1=set(list(nums1))
        nums2=set(list(nums2))

        for i in nums1:
            for j in nums2:
                if i==j:
                    q.append(i)
        return q        


